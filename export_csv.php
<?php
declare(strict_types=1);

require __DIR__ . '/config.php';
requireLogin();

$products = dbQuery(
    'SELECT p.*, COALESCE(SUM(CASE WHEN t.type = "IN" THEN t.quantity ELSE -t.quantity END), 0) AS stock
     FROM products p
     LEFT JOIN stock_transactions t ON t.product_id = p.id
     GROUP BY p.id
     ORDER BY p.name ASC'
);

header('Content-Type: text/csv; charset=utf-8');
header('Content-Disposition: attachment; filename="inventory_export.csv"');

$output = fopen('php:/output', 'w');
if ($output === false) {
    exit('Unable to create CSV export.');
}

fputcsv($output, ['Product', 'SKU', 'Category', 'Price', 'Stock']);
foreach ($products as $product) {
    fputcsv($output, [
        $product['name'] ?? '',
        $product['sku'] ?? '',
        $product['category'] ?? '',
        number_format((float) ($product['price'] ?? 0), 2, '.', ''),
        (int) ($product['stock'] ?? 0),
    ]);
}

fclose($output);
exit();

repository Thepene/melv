<?php
declare(strict_types=1);

require __DIR__ . '/config.php';
requireRole(['admin', 'manager']);

$user = currentUser();
$notice = $_GET['notice'] ?? '';
$error = $_GET['error'] ?? '';
$editId = isset($_GET['edit']) ? (int) $_GET['edit'] : null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    if ($action === 'add_supplier') {
        $name = trim((string) ($_POST['name'] ?? ''));
        $contactName = trim((string) ($_POST['contact_name'] ?? ''));
        $phone = trim((string) ($_POST['phone'] ?? ''));
        $email = trim((string) ($_POST['email'] ?? ''));
        $address = trim((string) ($_POST['address'] ?? ''));

        if ($name === '') {
            header('Location: suppliers.php?error=supplier_name_required');
            exit();
        }

        $saved = dbExecute(
            'INSERT INTO suppliers (name, contact_name, phone, email, address) VALUES (?, ?, ?, ?, ?)',
            [$name, $contactName, $phone, $email, $address]
        );

        if ($saved) {
            header('Location: suppliers.php?notice=supplier_added');
            exit();
        }

        header('Location: suppliers.php?error=supplier_save_failed');
        exit();
    }

    if ($action === 'update_supplier') {
        $id = (int) ($_POST['supplier_id'] ?? 0);
        $name = trim((string) ($_POST['name'] ?? ''));
        $contactName = trim((string) ($_POST['contact_name'] ?? ''));
        $phone = trim((string) ($_POST['phone'] ?? ''));
        $email = trim((string) ($_POST['email'] ?? ''));
        $address = trim((string) ($_POST['address'] ?? ''));

        if ($id <= 0 || $name === '') {
            header('Location: suppliers.php?error=invalid_supplier');
            exit();
        }

        $updated = dbExecute(
            'UPDATE suppliers SET name = ?, contact_name = ?, phone = ?, email = ?, address = ? WHERE id = ?',
            [$name, $contactName, $phone, $email, $address, $id]
        );

        if ($updated) {
            header('Location: suppliers.php?notice=supplier_updated');
            exit();
        }

        header('Location: suppliers.php?error=supplier_update_failed');
        exit();
    }

    if ($action === 'delete_supplier') {
        $id = (int) ($_POST['supplier_id'] ?? 0);
        if ($id > 0) {
            dbExecute('DELETE FROM suppliers WHERE id = ?', [$id]);
            header('Location: suppliers.php?notice=supplier_deleted');
            exit();
        }

        header('Location: suppliers.php?error=invalid_supplier');
        exit();
    }
}

if ($editId !== null) {
    $supplier = dbFetchOne('SELECT * FROM suppliers WHERE id = ? LIMIT 1', [$editId]);
} else {
    $supplier = null;
}

$suppliers = dbQuery('SELECT * FROM suppliers ORDER BY name ASC');
?>

