<?php
declare(strict_types=1);

require __DIR__ . '/config.php';
requireLogin();

$products = dbQuery(
    'SELECT p.*, COALESCE(SUM(CASE WHEN t.type = "IN" THEN t.quantity ELSE -t.quantity END), 0) AS stock
     FROM products p
     LEFT JOIN stock_transactions t ON t.product_id = p.id
     GROUP BY p.id
     ORDER BY p.name ASC'
);

header('Content-Type: application/pdf');
header('Content-Disposition: attachment; filename="inventory_export.pdf"');

$pdf = "%PDF-1.4\n";
$lines = [
    'Inventory Report',
    'Generated: ' . date('Y-m-d H:i:s'),
];

foreach ($products as $index => $product) {
    $lines[] = sprintf('%s | %s | %s | %s',
        $product['name'] ?? '',
        $product['sku'] ?? '',
        number_format((float) ($product['price'] ?? 0), 2, '.', ''),
        (int) ($product['stock'] ?? 0)
    );
}

$object = "<< /Type /Catalog /Pages 2 0 R >>";
$objects = [$object, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>", "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>"];

$stream = "BT\n/F1 12 Tf\n50 760 Td\n(Inventory Report) Tj\n0 -18 Td\n/F1 10 Tf\n";
$y = 730;
foreach ($lines as $line) {
    $stream .= sprintf("50 %d Td\n(%s) Tj\n", $y, str_replace(['\\', '(', ')'], ['\\\\', '\\(', '\\)'], $line));
    $y -= 15;
}
$stream .= "ET\n";
$objects[] = "<< /Length " . strlen($stream) . " >>\nstream\n" . $stream . "endstream";
$objects[] = "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>";

$pdf .= "";
$offsets = [];
foreach ($objects as $i => $objectEntry) {
    $offsets[$i] = strlen($pdf);
    $pdf .= ($i + 1) . " 0 obj\n" . $objectEntry . "\nendobj\n";
}

$xrefOffset = strlen($pdf);
$pdf .= "xref\n0 " . (count($objects) + 1) . "\n0000000000 65535 f \n";
for ($i = 0; $i < count($objects); $i++) {
    $pdf .= sprintf('%010d 00000 n \n', $offsets[$i]);
}
$pdf .= "trailer\n<< /Size " . (count($objects) + 1) . " /Root 1 0 R >>\nstartxref\n" . $xrefOffset . "\n%%EOF";

echo $pdf;
exit();


