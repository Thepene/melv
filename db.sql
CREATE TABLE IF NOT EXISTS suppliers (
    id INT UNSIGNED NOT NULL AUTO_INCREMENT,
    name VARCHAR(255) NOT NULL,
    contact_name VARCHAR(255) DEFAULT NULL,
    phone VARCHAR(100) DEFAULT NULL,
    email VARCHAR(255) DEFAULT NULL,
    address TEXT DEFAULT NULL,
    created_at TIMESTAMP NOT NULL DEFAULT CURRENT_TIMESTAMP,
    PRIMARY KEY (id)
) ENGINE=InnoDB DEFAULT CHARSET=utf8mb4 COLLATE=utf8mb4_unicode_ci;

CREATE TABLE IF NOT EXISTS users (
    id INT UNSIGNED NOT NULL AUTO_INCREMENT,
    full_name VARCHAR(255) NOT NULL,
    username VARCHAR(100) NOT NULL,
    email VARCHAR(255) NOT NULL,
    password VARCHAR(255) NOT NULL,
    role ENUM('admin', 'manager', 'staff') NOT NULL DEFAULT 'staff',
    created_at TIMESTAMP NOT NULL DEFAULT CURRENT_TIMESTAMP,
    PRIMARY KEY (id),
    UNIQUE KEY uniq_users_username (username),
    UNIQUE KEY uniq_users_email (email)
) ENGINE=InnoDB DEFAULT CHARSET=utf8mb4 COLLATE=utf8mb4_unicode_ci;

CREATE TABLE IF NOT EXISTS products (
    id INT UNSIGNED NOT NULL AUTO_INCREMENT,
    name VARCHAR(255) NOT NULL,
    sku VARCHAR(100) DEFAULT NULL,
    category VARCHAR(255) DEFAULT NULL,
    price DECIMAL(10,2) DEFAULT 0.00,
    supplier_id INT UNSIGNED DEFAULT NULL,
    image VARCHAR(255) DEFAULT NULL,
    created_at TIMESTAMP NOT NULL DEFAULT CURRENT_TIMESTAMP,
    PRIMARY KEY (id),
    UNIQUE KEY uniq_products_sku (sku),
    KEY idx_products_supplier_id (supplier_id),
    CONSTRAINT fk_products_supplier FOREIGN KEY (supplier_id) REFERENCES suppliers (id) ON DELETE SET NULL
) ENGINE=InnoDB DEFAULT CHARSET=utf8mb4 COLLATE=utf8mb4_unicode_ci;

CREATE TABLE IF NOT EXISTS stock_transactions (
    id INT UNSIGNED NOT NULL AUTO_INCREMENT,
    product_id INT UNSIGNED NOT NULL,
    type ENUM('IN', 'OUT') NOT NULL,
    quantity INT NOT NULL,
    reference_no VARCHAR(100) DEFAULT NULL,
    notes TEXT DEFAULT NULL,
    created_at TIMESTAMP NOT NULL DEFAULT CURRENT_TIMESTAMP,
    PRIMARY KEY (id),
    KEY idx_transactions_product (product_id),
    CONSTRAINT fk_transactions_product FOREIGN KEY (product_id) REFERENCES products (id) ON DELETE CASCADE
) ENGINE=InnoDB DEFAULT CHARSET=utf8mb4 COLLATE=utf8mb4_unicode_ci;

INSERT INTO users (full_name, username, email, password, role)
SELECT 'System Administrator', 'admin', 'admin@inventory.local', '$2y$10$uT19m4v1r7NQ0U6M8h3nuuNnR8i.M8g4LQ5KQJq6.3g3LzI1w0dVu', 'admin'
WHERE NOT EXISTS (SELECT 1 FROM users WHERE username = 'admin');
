<?php
$dbConfig = [
    'host' => getenv('DB_HOST') ?: '127.0.0.1',
    'port' => getenv('DB_PORT') ?: '3306',
    'database' => getenv('DB_NAME') ?: 'melv',
    'username' => getenv('DB_USER') ?: 'root',
    'password' => getenv('DB_PASS') ?: '',
    'charset' => 'utf8mb4',
];

function getDatabaseConfig(): array
{
    global $dbConfig;

    return $dbConfig;
}

function getDatabaseConnection(): PDO
{
    static $pdo = null;

    if ($pdo instanceof PDO) {
        return $pdo;
    }

    $config = getDatabaseConfig();
    $dsn = sprintf(
        'mysql:host=%s;port=%d;dbname=%s;charset=%s',
        $config['host'],
        (int) $config['port'],
        $config['database'],
        $config['charset']
    );

    $pdo = new PDO($dsn, $config['username'], $config['password'], [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        PDO::ATTR_EMULATE_PREPARES => false,
    ]);

    return $pdo;
}

function normaliseTableName(string $name): string
{
    return preg_replace('/[^a-zA-Z0-9_]/', '', $name) ?: 'items';
}

function loadJsonStore(string $name, array $default = []): array
{
    $table = normaliseTableName($name);

    try {
        $pdo = getDatabaseConnection();
        $statement = $pdo->query("SELECT * FROM `{$table}` ORDER BY id ASC");
        $rows = $statement->fetchAll();

        return is_array($rows) ? $rows : $default;
    } catch (Throwable $exception) {
        ensureJsonDatabase();

        try {
            $pdo = getDatabaseConnection();
            $statement = $pdo->query("SELECT * FROM `{$table}` ORDER BY id ASC");
            $rows = $statement->fetchAll();

            return is_array($rows) ? $rows : $default;
        } catch (Throwable $secondException) {
            return $default;
        }
    }
}

function saveJsonStore(string $name, array $data): bool
{
    $table = normaliseTableName($name);

    try {
        $pdo = getDatabaseConnection();
        $pdo->beginTransaction();
        $pdo->exec("DELETE FROM `{$table}`");

        if ($data === []) {
            $pdo->commit();
            return true;
        }

        $columns = [];
        foreach ($data as $row) {
            if (!is_array($row)) {
                continue;
            }

            foreach (array_keys($row) as $column) {
                if (!in_array($column, $columns, true)) {
                    $columns[] = $column;
                }
            }
        }

        if ($columns === []) {
            $pdo->commit();
            return true;
        }

        $columnList = implode('`, `', $columns);
        $valueGroups = [];
        foreach ($data as $index => $row) {
            $placeholders = [];
            foreach ($columns as $column) {
                $placeholders[] = ':' . $column . '_' . $index;
            }
            $valueGroups[] = '(' . implode(', ', $placeholders) . ')';
        }

        $sql = sprintf(
            'INSERT INTO `%s` (`%s`) VALUES %s',
            $table,
            $columnList,
            implode(', ', $valueGroups)
        );

        $statement = $pdo->prepare($sql);
        foreach ($data as $index => $row) {
            foreach ($columns as $column) {
                $statement->bindValue(':' . $column . '_' . $index, $row[$column] ?? null);
            }
        }

        $statement->execute();
        $pdo->commit();

        return true;
    } catch (Throwable $exception) {
        try {
            $pdo->rollBack();
        } catch (Throwable $ignored) {
        }

        return false;
    }
}

function nextJsonId(array $items): int
{
    $maxId = 0;
    foreach ($items as $item) {
        $id = isset($item['id']) ? (int) $item['id'] : 0;
        if ($id > $maxId) {
            $maxId = $id;
        }
    }

    return $maxId + 1;
}

function inventoryStockForProduct(int $productId, array $transactions): int
{
    $stock = 0;
    foreach ($transactions as $transaction) {
        if ((int) ($transaction['product_id'] ?? 0) !== $productId) {
            continue;
        }

        $quantity = (int) ($transaction['quantity'] ?? 0);
        $stock += (($transaction['type'] ?? 'IN') === 'IN') ? $quantity : -$quantity;
    }

    return $stock;
}

