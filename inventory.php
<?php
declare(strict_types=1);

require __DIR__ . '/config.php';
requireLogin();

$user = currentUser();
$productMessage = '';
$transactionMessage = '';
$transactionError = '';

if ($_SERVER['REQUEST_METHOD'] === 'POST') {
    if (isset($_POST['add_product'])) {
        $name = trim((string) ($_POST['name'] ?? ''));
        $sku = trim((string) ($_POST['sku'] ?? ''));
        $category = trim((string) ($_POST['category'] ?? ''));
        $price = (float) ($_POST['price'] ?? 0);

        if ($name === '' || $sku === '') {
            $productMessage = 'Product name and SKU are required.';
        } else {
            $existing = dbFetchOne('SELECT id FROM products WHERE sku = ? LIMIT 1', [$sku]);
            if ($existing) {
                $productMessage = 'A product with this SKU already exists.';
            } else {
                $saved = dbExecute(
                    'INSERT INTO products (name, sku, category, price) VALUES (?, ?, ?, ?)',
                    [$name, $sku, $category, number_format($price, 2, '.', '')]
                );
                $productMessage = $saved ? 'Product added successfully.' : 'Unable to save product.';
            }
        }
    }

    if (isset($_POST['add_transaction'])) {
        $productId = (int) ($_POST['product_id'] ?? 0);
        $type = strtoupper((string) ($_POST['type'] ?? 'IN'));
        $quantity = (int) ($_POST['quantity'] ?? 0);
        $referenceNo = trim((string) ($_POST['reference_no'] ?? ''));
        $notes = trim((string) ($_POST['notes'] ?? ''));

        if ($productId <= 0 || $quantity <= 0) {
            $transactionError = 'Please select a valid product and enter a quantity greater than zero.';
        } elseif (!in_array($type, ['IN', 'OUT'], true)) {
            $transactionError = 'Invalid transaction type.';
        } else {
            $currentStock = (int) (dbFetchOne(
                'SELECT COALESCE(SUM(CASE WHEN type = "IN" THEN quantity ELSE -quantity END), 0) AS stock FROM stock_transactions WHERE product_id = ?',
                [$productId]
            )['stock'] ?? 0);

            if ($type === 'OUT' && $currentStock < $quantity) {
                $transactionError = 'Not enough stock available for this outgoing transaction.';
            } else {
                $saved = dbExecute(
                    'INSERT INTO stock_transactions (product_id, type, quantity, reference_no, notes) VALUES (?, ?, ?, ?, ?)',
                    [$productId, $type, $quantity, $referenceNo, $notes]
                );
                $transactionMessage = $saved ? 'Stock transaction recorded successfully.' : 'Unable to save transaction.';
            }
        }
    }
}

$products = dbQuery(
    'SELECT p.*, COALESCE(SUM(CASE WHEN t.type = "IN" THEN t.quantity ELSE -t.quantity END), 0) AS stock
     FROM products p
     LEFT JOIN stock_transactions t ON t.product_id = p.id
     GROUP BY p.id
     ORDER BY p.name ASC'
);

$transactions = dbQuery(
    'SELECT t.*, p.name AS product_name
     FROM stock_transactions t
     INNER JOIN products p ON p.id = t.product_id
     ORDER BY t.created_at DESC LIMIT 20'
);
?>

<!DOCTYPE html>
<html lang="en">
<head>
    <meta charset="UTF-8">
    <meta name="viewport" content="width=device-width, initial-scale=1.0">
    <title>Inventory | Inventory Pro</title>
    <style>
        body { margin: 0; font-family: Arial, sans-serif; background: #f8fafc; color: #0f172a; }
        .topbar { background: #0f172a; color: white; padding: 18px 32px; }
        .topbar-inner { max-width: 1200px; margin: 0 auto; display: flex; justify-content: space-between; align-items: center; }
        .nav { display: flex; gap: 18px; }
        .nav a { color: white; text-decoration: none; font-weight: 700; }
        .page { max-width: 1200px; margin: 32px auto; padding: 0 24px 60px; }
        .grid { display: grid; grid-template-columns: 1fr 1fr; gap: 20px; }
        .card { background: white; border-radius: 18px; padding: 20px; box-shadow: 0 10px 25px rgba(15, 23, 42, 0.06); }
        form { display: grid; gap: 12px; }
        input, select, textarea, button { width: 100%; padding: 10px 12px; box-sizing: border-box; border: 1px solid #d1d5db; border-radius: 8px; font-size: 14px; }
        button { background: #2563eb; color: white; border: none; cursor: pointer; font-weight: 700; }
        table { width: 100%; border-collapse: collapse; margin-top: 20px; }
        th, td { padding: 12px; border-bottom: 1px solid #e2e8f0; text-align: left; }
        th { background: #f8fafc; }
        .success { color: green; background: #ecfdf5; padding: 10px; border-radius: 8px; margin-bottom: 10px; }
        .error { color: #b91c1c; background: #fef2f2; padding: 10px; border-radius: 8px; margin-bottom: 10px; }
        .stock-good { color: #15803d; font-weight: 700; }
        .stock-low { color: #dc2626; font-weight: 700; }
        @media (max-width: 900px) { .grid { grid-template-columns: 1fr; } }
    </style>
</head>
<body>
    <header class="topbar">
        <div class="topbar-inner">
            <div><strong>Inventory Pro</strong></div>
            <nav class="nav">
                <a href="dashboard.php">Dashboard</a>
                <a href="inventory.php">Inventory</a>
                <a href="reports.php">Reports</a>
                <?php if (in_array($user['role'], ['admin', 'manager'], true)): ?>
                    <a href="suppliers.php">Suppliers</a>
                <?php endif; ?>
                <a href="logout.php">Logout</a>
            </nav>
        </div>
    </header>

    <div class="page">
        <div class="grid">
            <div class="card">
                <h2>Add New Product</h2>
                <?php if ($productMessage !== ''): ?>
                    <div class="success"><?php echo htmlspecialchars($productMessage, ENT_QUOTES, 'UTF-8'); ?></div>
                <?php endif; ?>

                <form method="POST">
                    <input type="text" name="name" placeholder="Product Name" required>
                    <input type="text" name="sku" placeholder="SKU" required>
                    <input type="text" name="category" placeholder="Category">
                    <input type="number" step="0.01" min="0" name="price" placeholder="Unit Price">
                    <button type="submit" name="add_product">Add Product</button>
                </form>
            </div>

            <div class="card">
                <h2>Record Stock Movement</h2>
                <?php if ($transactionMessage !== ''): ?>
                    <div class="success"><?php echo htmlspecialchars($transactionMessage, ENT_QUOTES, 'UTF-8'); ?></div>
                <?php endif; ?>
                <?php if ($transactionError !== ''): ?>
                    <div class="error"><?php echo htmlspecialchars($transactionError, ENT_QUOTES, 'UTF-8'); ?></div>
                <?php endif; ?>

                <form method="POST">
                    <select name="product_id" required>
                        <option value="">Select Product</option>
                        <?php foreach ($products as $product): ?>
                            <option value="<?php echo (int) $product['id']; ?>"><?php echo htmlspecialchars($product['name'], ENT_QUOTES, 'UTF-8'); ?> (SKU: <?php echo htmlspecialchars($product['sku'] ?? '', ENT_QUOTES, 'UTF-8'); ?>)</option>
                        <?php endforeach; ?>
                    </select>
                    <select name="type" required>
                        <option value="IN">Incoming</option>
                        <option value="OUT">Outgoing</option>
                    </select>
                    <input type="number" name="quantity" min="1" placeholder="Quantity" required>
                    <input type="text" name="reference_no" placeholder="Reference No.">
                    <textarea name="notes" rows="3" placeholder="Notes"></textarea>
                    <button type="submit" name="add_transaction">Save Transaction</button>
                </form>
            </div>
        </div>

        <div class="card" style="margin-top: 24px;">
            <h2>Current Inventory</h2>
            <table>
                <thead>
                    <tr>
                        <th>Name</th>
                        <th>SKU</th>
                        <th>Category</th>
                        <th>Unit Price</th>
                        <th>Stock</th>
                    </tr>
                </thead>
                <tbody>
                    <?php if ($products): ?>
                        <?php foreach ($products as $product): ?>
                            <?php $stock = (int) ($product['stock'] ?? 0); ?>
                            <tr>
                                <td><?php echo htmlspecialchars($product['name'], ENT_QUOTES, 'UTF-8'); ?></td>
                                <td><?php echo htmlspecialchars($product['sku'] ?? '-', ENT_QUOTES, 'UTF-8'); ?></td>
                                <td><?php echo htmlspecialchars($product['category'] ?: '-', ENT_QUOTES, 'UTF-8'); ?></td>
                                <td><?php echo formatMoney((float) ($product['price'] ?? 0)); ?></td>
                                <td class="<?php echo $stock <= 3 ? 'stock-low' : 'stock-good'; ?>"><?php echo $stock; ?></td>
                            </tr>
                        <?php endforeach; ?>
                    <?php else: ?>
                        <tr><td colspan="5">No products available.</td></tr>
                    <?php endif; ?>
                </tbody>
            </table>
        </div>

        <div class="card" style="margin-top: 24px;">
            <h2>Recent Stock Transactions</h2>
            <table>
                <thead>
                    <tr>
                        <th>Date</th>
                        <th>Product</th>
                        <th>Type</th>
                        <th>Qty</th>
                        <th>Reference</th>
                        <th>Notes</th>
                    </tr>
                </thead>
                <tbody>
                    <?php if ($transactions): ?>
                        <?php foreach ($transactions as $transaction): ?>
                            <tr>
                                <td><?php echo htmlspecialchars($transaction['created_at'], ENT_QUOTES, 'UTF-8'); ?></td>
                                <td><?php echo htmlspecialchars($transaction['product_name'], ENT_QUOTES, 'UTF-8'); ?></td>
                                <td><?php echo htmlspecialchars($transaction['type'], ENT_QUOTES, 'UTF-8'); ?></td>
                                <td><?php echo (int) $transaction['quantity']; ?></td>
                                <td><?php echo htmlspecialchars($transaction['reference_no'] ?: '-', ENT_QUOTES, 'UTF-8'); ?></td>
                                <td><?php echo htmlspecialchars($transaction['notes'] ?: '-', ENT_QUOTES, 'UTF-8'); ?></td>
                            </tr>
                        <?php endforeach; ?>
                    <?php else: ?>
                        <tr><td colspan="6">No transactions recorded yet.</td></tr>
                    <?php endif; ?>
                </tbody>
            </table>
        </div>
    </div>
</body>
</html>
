<?php
declare(strict_types=1);

require __DIR__ . '/config.php';
requireLogin();

$user = currentUser();

$productMessage = '';
$transactionMessage = '';
$transactionError = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['add_product'])) {
        $name = trim((string) ($_POST['name'] ?? ''));
        $sku = trim((string) ($_POST['sku'] ?? ''));
        $category = trim((string) ($_POST['category'] ?? ''));
        $price = (float) ($_POST['price'] ?? 0);

        if ($name === '' || $sku === '') {
            $productMessage = 'Product name and SKU are required.';
        } else {
            $existing = dbFetchOne('SELECT id FROM products WHERE sku = ? LIMIT 1', [$sku]);
            if ($existing) {
                $productMessage = 'A product with this SKU already exists.';
            } else {
                $success = dbExecute(
                    'INSERT INTO products (name, sku, category, price) VALUES (?, ?, ?, ?)',
                    [$name, $sku, $category, number_format($price, 2, '.', '')]
                );

                $productMessage = $success ? 'Product added successfully.' : 'Unable to save product.';
            }
        }
    }

    if (isset($_POST['add_transaction'])) {
        $productId = (int) ($_POST['product_id'] ?? 0);
        $type = strtoupper((string) ($_POST['type'] ?? 'IN'));
        $quantity = (int) ($_POST['quantity'] ?? 0);
        $referenceNo = trim((string) ($_POST['reference_no'] ?? ''));
        $notes = trim((string) ($_POST['notes'] ?? ''));

        if ($productId <= 0 || $quantity <= 0) {
            $transactionError = 'Please select a valid product and enter a quantity greater than zero.';
        } elseif (!in_array($type, ['IN', 'OUT'], true)) {
            $transactionError = 'Invalid transaction type.';
        } else {
            $stock = (int) (dbFetchOne('SELECT COALESCE(SUM(CASE WHEN type = "IN" THEN quantity ELSE -quantity END), 0) AS stock FROM stock_transactions WHERE product_id = ?', [$productId])['stock'] ?? 0);

            if ($type === 'OUT' && $stock < $quantity) {
                $transactionError = 'Not enough stock available for this outgoing transaction.';
            } else {
                $saved = dbExecute(
                    'INSERT INTO stock_transactions (product_id, type, quantity, reference_no, notes) VALUES (?, ?, ?, ?, ?)',
                    [$productId, $type, $quantity, $referenceNo, $notes]
                );

                $transactionMessage = $saved ? 'Stock transaction recorded successfully.' : 'Unable to save transaction.';
            }
        }
    }
}

$products = dbQuery(
    'SELECT p.*, COALESCE(SUM(CASE WHEN t.type = "IN" THEN t.quantity ELSE -t.quantity END), 0) AS stock
     FROM products p
     LEFT JOIN stock_transactions t ON t.product_id = p.id
     GROUP BY p.id
     ORDER BY p.name ASC'
);

$transactionRows = dbQuery(
    'SELECT t.*, p.name AS product_name
     FROM stock_transactions t
     INNER JOIN products p ON p.id = t.product_id
     ORDER BY t.created_at DESC
     LIMIT 20'
);

$summary = [
    'products' => count($products),
    'stock_in' => array_sum(array_map(static fn($product) => (int) ($product['stock'] ?? 0), $products)),
    'low_stock' => count(array_filter($products, static fn($product) => (int) ($product['stock'] ?? 0) <= 3)),
    'transactions' => count($transactionRows),
];
?>

